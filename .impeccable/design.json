      "html": "<section class=\"ds-sheet\" dir=\"rtl\" role=\"dialog\" aria-labelledby=\"ds-sheet-title\" aria-describedby=\"ds-sheet-description\"><div class=\"ds-grip-area\" aria-hidden=\"true\"><div class=\"ds-grip\"></div></div><header class=\"ds-sheet-header\"><h2 class=\"ds-sheet-title\" id=\"ds-sheet-title\" tabindex=\"-1\">کارشناسان فروش</h2></header><div class=\"ds-sheet-body\"><p id=\"ds-sheet-description\">برای گفت‌وگو با کارشناس فروش، نام موردنظر را انتخاب کنید.</p></div></section>",
      "css": ".ds-sheet{font-family:var(--font-peyda),Tahoma,sans-serif;--bleed:2rem;display:flex;flex-direction:column;width:min(100%,34rem);max-height:calc(100dvh - 1rem + var(--bleed));margin-bottom:calc(-1 * var(--bleed));padding-bottom:var(--bleed);overflow:hidden;border-radius:var(--radius-sheet) var(--radius-sheet) 0 0;background:var(--white);color:var(--ink);text-align:center;box-shadow:0 -8px 40px rgb(41 39 39 / 8%);transform:translateY(var(--drawer-swipe-movement-y,0px));transition:transform var(--duration-sheet) var(--ease-sheet)}.ds-sheet[data-starting-style],.ds-sheet[data-ending-style]{transform:translateY(calc(100% - var(--bleed) + 2px))}.ds-sheet[data-swiping]{user-select:none;transition-duration:0ms}.ds-grip-area{flex:none;padding-block:12px 4px}.ds-grip{width:36px;height:4px;margin-inline:auto;border-radius:2px;background:var(--line)}.ds-sheet-header{flex:none;display:grid;grid-template-columns:44px minmax(0,1fr) 44px;align-items:center;padding-inline:var(--space-md);padding-bottom:var(--space-sm)}.ds-sheet-title{grid-column:2;grid-row:1;margin:0;font-size:1.125rem;font-weight:700;line-height:1.8}.ds-sheet-title:focus-visible{outline:2px solid var(--deep-red);outline-offset:4px}.ds-sheet-body{min-height:0;overflow-y:auto;overscroll-behavior-y:contain;padding:var(--space-sm) max(var(--space-lg),env(safe-area-inset-right)) max(var(--space-lg),env(safe-area-inset-bottom)) max(var(--space-lg),env(safe-area-inset-left))}.ds-sheet-body p{margin:0 auto var(--space-lg);max-width:26rem;font-size:.875rem;line-height:1.9;color:var(--muted);text-wrap:pretty}@media(prefers-reduced-motion:reduce){.ds-sheet{transition-duration:0ms}}"
