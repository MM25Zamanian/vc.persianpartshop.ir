# The exported vCard is a file; restore the route's download headers.
location = /contacts.vcf {
  include /etc/nginx/conf.d/location.d/root.d/*.conf;
  default_type text/vcard;
  charset utf-8;
  add_header Content-Disposition 'attachment; filename="zamanian-contacts.vcf"';
  try_files $uri =404;
}
